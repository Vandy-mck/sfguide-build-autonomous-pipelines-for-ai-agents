# =============================================================================
#  .env.template — Copy to .env and fill in your values
#
#  cp .env.template .env
# =============================================================================

# ── Snowflake connection ─────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<account_identifier>
SNOWFLAKE_USER=<myuser>
SNOWFLAKE_ROLE=SUMMIT_ADMIN
SNOWFLAKE_WAREHOUSE=SUMMIT_WH
SNOWFLAKE_CONNECTION_NAME=summit
SNOWFLAKE_PAT=<your_programmatic_access_token_here>

# ── DCM Project ──────────────────────────────────────────────────────────────
DCM_DATABASE=DCM_DB
DCM_SCHEMA=PROJECTS
DCM_PROJECT=DCM_PROJECT_DEV

# ── Kafka ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=<localhost:9092>
KAFKA_USERNAME=<kafka_user>
KAFKA_PASSWORD=<kafka_pass>
KAFKA_TOPIC_PREFIX=tms

# ── TMS Producer ─────────────────────────────────────────────────────────────
TMS_ORDER_COUNT=1
TMS_DELAY=1.0
TMS_FRAUD_RATE=0.01
TMS_RETURN_RATE=0.02
TMS_DAYS_BACK=7
